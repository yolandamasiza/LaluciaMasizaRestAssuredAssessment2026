    {
      "name": "Announcements",
      "item": [
        {
          "name": "Create Announcement",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.environment.set(\"announcementId\", response.data.id);\r",
                  "\r",
                  "console.log(\"Announcement ID:\", response.data.id);\r",
                  "\r",
                  "pm.test(\"Announcement created successfully\", function () {\r",
                  "    pm.expect(response.success).to.eql(true);\r",
                  "    pm.expect(response.message).to.eql(\"Announcement created successfully\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"title\": \"Important Update\",\r\n    \"content\": \"This is the announcement content\"\r\n}",
